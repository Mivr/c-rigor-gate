)

# The byte-array generator of `c_embed` (T112, rules/embed.bzl): a binary file -> a const C array and its length.
export_file(
    name = "bin2c.py",
    visibility = ["PUBLIC"],
)

# The shard merge of `c_sim` (T2G1, rules/sim.bzl): stdlib only, runs inside the action.
