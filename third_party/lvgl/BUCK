_SRCS = _CORE + _DRAW + _FONT + _MISC + _PLATFORM + _WIDGETS_AND_TEST

# Public headers keep their layout: `#include "lvgl.h"` (the top header includes include/lvgl/lvgl.h).
_PUBLIC = {
    "lvgl.h": "lvgl.h",
    "lvgl_private.h": "lvgl_private.h",
    "lv_version.h": "lv_version.h",
}
_PUBLIC.update({f: f for f in LVGL_FILES if f.startswith("include/")})

c_third_party(
    name = "lvgl",
    url = "https://github.com/lvgl/lvgl/archive/refs/tags/v9.6.0.tar.gz",
    sha256 = "b20ee3acc1bba13c62d854f9ebd62e4c51e0b443b1e0225892e86442defa84df",
    size_bytes = 111467067,
    top = "lvgl-9.6.0",
    dirs = ["src", "include", "lvgl.h", "lvgl_private.h", "lv_version.h"],
    files = LVGL_FILES,
    srcs = _SRCS,
    own_srcs = ["lvgl_gate.c"],
    private_headers = [],
    public_headers = [],
    public_header_map = _PUBLIC,
    tree_input = True,
    # T114: LVGL calls its own typed callbacks through `void *`-typed pointers (lv_cache.c:179, installed at
    # lv_tiny_ttf.c:444); the clang function-type check cannot pass them. Only that check, only this library.
    no_sanitize = ["function"],
    config_header = "gate_lv_conf.h",
    config_macro = "LV_CONF_PATH",
    extra_headers = {"lvgl_gate.h": "lvgl_gate.h"},
)

export_file(name = "gate_lv_conf.h", visibility = ["//third_party/..."])

export_file(name = "lvgl_gate.h", visibility = ["//third_party/..."])

export_file(name = "lvgl_gate.c", visibility = ["//third_party/..."])
