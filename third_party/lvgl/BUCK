load("@gate//rules:third_party.bzl", "c_third_party")
load(":files.bzl", "LVGL_FILES")

# LVGL 9.6.0, release tarball pinned by sha256. See docs/third-party.md.
#
# Compiled: the core, the software renderer, the label / button / image widgets, flex and grid layouts, the
# default theme, the Montserrat 14 font, Tiny TTF (fonts from memory), the builtin allocator and string
# functions, the OS-less port, the test inputs and the init. Each directory below says what is NOT compiled.
