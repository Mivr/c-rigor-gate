"""`<name>_facts`: what the compiler and the linker actually saw, as one cacheable JSON file.

`<name>_facts` is built in the release mode, `<name>_facts_san` (same rule, same scanner) in the `san`
mode (T023). Each also carries the called-function set of the preprocessed text as `[calls]`
(`gate/rigor_lib/facts_modes.py`); `rigor facts --modes` compares the two modes. For every source of the target the prelude already produces, with
the very same compile command, the `clang -E` output (`[objects][<unit>][preprocessed]`) and the
release object. A gate-owned Python script (`gate/rigor_lib/cscan.py`) scans the former and lists
the symbols of the latter with the pinned `llvm-nm`. The file is data; `rigor facts` decides.
"""

def _label_text(label: Label, name: str | None = None) -> str:
    cell = "" if label.cell == "root" else label.cell
    return "{}//{}:{}".format(cell, label.package, name if name else label.name)

def _facts_impl(ctx: AnalysisContext) -> list[Provider]:
    # Headers of the gate's own third-party libraries are not the product's text (T108), like the toolchain's:
    # their materialised tree is `.../art/<gate cell>/third_party/...` (the same fragment `c_structure` uses).
    vendor = "/art/{}/third_party/".format(ctx.attrs._ctest.label.cell)
    # The gate's own header tree (`gate//rt:require`, T131): `.../<cell>/<package>/__<name>__/...`. A file read from it is
    # the gate's, also when the gate is the root cell (the gate's own selftests), where no cell name tells it apart.
    require = ctx.attrs._require.label
    gate_marker = "/{}/{}/__{}__/".format(require.cell, require.package, require.name)
    subs = ctx.attrs.unit[DefaultInfo].sub_targets
    every = subs["objects"][DefaultInfo].sub_targets if "objects" in subs else {}

    # A library has a position-independent twin of each object; the plain one is what gets linked.
    objects = {name: unit for name, unit in every.items() if not name.endswith(".pic.o")}
    expected = len(ctx.attrs.srcs) + len(ctx.attrs.generated)
    if len(objects) != expected:
        fail("{}: expected {} compiled units, the compiler produced {}".format(
            ctx.label, expected, len(objects),
        ))
    facts = ctx.actions.declare_output("facts.json")
    cmd = cmd_args(
        "/usr/bin/env",
        "python3",
        "-I",
        "-B",
        ctx.attrs._scanner,
        "--label",
        _label_text(ctx.label, ctx.attrs.facts_name),
        "--kind",
        ctx.attrs.kind,
        "--nm",
        ctx.attrs._nm[RunInfo],
        ctx.attrs._roots[RunInfo],
        "--vendor-marker",
        vendor,
        "--gate-marker",
        gate_marker,
        "--out",
        facts.as_output(),
    )
    for dep in ctx.attrs.facts_deps:
        cmd.add("--dep", _label_text(dep.label))
    for lib in ctx.attrs.system_libs:
        cmd.add("--system-lib", lib)
    for name in sorted(objects.keys()):
        unit = objects[name][DefaultInfo]
        cmd.add(
            "--unit",
            name,
            unit.sub_targets["preprocessed"][DefaultInfo].default_outputs[0],
            unit.default_outputs[0],
        )
    ctx.actions.run(cmd, category = "c_facts")

    # The called-function set per unit, from the same preprocessed text (for the mode comparison).
    calls = ctx.actions.declare_output("calls.json")
    calls_cmd = cmd_args(
        "/usr/bin/env",
        "python3",
        "-I",
        "-B",
        ctx.attrs._modes_scanner,
        "scan",
        "--label",
        _label_text(ctx.label, ctx.attrs.facts_name),
        "--cscan",
        ctx.attrs._scanner,
        ctx.attrs._roots[RunInfo],
        "--vendor-marker",
        vendor,
        "--out",
        calls.as_output(),
    )
    for name in sorted(objects.keys()):
        calls_cmd.add("--unit", name, objects[name][DefaultInfo].sub_targets["preprocessed"][DefaultInfo].default_outputs[0])
    ctx.actions.run(calls_cmd, category = "c_calls")
    return [DefaultInfo(default_output = facts, sub_targets = {"calls": [DefaultInfo(default_output = calls)]})]

_ATTRS = {
    "facts_deps": attrs.list(attrs.dep(), default = []),
    "facts_name": attrs.string(),
    # Names of sources generated by a gate rule (`c_catalog`, T105): compiled and scanned like `srcs`, but
    # they are no file of the package, so `rigor structure` gets none (it reads the `srcs` attribute only).
    "generated": attrs.list(attrs.string(), default = []),
    "kind": attrs.string(),
    "srcs": attrs.list(attrs.string(), default = []),
    "system_libs": attrs.list(attrs.string(), default = []),
    "unit": attrs.dep(),
    "_ctest": attrs.dep(default = "gate//ctest:ctest"),
    "_modes_scanner": attrs.source(default = "gate//gate/rigor_lib:facts_modes.py"),
    "_require": attrs.dep(default = "gate//rt:require"),
    "_nm": attrs.exec_dep(default = "toolchains//:llvm-nm", providers = [RunInfo]),
    "_roots": attrs.exec_dep(default = "toolchains//:system-roots", providers = [RunInfo]),
    "_scanner": attrs.source(default = "gate//gate/rigor_lib:cscan.py"),
}

c_facts = rule(impl = _facts_impl, attrs = _ATTRS)

# The same rule under another name for the `san` twin: `kind(c_facts, //...)` (what `rigor grade` builds,
# in the release platform) must not pick the san targets up, and a regex `c_facts` does not match this name.
c_san_facts = rule(impl = _facts_impl, attrs = _ATTRS)
