WORKER_IMAGE = read_root_config("rbe", "worker_image_digest", "")

# ---------------------------------------------------------------------------
# Modes (a target-platform constraint). Select with --target-platforms
# toolchains//:linux_<mode>; the default is release.
# ---------------------------------------------------------------------------

constraint_setting(name = "mode")

# Never satisfied by any platform; used to mark targets incompatible with a mode.
constraint_value(name = "never", constraint_setting = ":mode")

[
    constraint_value(name = m, constraint_setting = ":mode")
    for m in ["release", "san", "cov", "fuzz", "android"]
]

exec_platform(
    name = "platforms",
    cpu_configuration = "prelude//cpu/constraints:x86_64",
    os_configuration = "prelude//os/constraints:linux",
    worker_image = WORKER_IMAGE,
    visibility = ["PUBLIC"],
)

[
    target_platform(
        name = "linux_" + m,
        cpu_configuration = "prelude//cpu/constraints:x86_64",
        os_configuration = "prelude//os/constraints:linux",
        mode = ":" + m,
        visibility = ["PUBLIC"],
    )
    for m in ["release", "san", "cov", "fuzz"]
]

# Android (aarch64, API 28, 16 KB pages): compiled and linked on the RE farm by the NDK's clang; the result is never
# run there. The mode is its own value so every gate that reads release or san objects (facts, mutants, structure,
# perf, ctest verdicts) stays incompatible with it. Select with --target-platforms toolchains//:android_release.
target_platform(
    name = "android_release",
    cpu_configuration = "prelude//cpu/constraints:arm64",
    os_configuration = "prelude//os/constraints:android",
    mode = ":android",
    visibility = ["PUBLIC"],
)

