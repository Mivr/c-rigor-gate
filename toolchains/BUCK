WORKER_IMAGE = read_root_config("rbe", "worker_image_digest", "")

# ---------------------------------------------------------------------------
# Modes (a target-platform constraint). Select with --target-platforms
# toolchains//:linux_<mode>; the default is release.
# ---------------------------------------------------------------------------

constraint_setting(name = "mode")

# Never satisfied by any platform; used to mark targets incompatible with a mode.
constraint_value(name = "never", constraint_setting = ":mode")

[
    constraint_value(name = m, constraint_setting = ":mode")
    for m in ["release", "san", "cov", "fuzz"]
]

exec_platform(
    name = "platforms",
    cpu_configuration = "prelude//cpu/constraints:x86_64",
    os_configuration = "prelude//os/constraints:linux",
    worker_image = WORKER_IMAGE,
    visibility = ["PUBLIC"],
)

[
    target_platform(
        name = "linux_" + m,
        cpu_configuration = "prelude//cpu/constraints:x86_64",
        os_configuration = "prelude//os/constraints:linux",
        mode = ":" + m,
        visibility = ["PUBLIC"],
    )
    for m in ["release", "san", "cov", "fuzz"]
]

