    name = "libc_symbols_android",
    libs = ["libc.so", "libm.so", "libdl.so", "libandroid.so", "liblog.so"],
    dir = _NDK_ABI + "28/",
    sysroot = ":ndk",
    visibility = ["PUBLIC"],
)

