# Android NDK r29 (clang 21, bionic sysroot). A zip: unpacked on RE by `fetched_zip_tree`, members only.
_NDK = "android-ndk-r29/toolchains/llvm/prebuilt/linux-x86_64/"
_NDK_ABI = _NDK + "sysroot/usr/lib/aarch64-linux-android/"
_NDK_INC = _NDK + "sysroot/usr/include/"

fetched_zip_tree(
    name = "ndk",
    url = "https://dl.google.com/android/repository/android-ndk-r29-linux.zip",
    sha256 = "4abbbcdc842f3d4879206e9695d52709603e52dd68d3c1fff04b3b5e7a308ecf",
    size_bytes = 783549481,
    script = "unzip_members.py",
    members = [
        _NDK + "bin/clang-21",
        _NDK + "bin/lld",
        _NDK + "bin/ld.lld",
        _NDK + "bin/llvm-ar",
        _NDK + "bin/llvm-ranlib",
        _NDK + "bin/llvm-nm",
        _NDK + "bin/llvm-objcopy",
        _NDK + "bin/llvm-strip",
        _NDK + "bin/llvm-objdump",
        _NDK + "bin/llvm-readelf",
        _NDK + "bin/llvm-readobj",  # the target of the llvm-readelf link
        _NDK + "lib/clang/21/include",
        _NDK + "lib/clang/21/lib/linux/libclang_rt.builtins-aarch64-android.a",
        _NDK + "lib/clang/21/lib/linux/aarch64/libunwind.a",
        _NDK + "lib/clang/21/lib/linux/aarch64/libatomic.a",
        # Bionic: link stubs and startup objects for API 28 only, and the headers (no C++ headers, no other ABI).
        _NDK_ABI + "28",
        _NDK_INC + "*.h",
    ] + [_NDK_INC + d for d in [
        "aarch64-linux-android",
        "android",
        "arpa",
        "asm-generic",
        "bits",
