# Android SDK parts for `c_apk` (T-G3), the very releases of the Rust kiosk's toolchains/android.bzl (same URLs, sha256, sizes).
# Members only, as for the NDK: build-tools r35 (aapt2, zipalign and their library, the apksigner and d8 jars), the platform-35
# android.jar, and the Temurin 21.0.6+7 JDK (java and keytool with the runtime they load: `lib/modules`, `lib/*.so`, the
# security files), no `src.zip`, `ct.sym`, `jmods`, JFR or any other tool.
_BT = "android-15/"
_JDK = "jdk-21.0.6+7/"

fetched_zip_tree(
    name = "android_build_tools",
    url = "https://dl.google.com/android/repository/build-tools_r35_linux.zip",
    sha256 = "bd3a4966912eb8b30ed0d00b0cda6b6543b949d5ffe00bea54c04c81e1561d88",
    size_bytes = 61958799,
    script = "unzip_members.py",
    members = [_BT + "aapt2", _BT + "zipalign", _BT + "lib64/libc++.so", _BT + "lib/apksigner.jar", _BT + "lib/d8.jar", _BT + "source.properties"],
    visibility = ["PUBLIC"],
)

fetched_zip_tree(
    name = "android_platform",
    url = "https://dl.google.com/android/repository/platform-35_r02.zip",
    sha256 = "0988cacad01b38a18a47bac14a0695f246bc76c1b06c0eeb8eb0dc825ab0c8e0",
    size_bytes = 64273788,
    script = "unzip_members.py",
    members = ["android-35/android.jar", "android-35/source.properties"],
    visibility = ["PUBLIC"],
)

fetched_tree(
    name = "jdk",
    url = "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.6%2B7/OpenJDK21U-jdk_x64_linux_hotspot_21.0.6_7.tar.gz",
    sha256 = "a2650fba422283fbed20d936ce5d2a52906a5414ec17b2f7676dddb87201dbae",
    size_bytes = 206861665,
    gzip = True,
