# The tools of `c_apk` and the selftest (RunInfo; each carries its tree). `apksigner` and `d8` run the build-tools jars on the pinned JDK.
tree_bin(name = "aapt2", tree = ":android_build_tools", bin = _BT + "aapt2", visibility = ["PUBLIC"])
tree_bin(name = "zipalign", tree = ":android_build_tools", bin = _BT + "zipalign", visibility = ["PUBLIC"])
tree_bin(name = "keytool", tree = ":jdk", bin = _JDK + "bin/keytool", visibility = ["PUBLIC"])
java_jar(name = "apksigner", jdk = ":jdk", java = _JDK + "bin/java", tree = ":android_build_tools", jar = _BT + "lib/apksigner.jar", visibility = ["PUBLIC"])
java_jar(name = "d8", jdk = ":jdk", java = _JDK + "bin/java", tree = ":android_build_tools", jar = _BT + "lib/d8.jar", main = "com.android.tools.r8.D8", visibility = ["PUBLIC"])

# The TEST-ONLY debug signing key of `c_apk` (public password `android`) and its certificate's SHA-256, which every
# `<name>_check` pins. A release key is not in this repository and no product can name one.
export_file(name = "android_debug.keystore", visibility = ["PUBLIC"])
export_file(name = "android_debug.cert.sha256", visibility = ["PUBLIC"])

# Verified reuse of the trees by an `--uncached` grade (gate/rigor_lib/toolchain_verify.py).
[
    (
        tree_ref(name = t + "_ref", tree = ":" + t, visibility = ["PUBLIC"]),
        verified_tree(
            name = t + "_verified",
            tree = ":" + t,
            manifest = t + ".manifest",
            script = "verify_tree.py",
            visibility = ["PUBLIC"],
        ),
    )
    for t in ["llvm", "sysroot", "ndk", "android_build_tools", "android_platform", "jdk"]
]

