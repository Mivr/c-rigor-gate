)

# The NDK twins of `system-roots` and `libc_symbols`: the clang and bionic header directories, and every symbol the API 28
# stubs of libc, libm, libdl, libandroid and liblog export (what an Android product must not redefine).
ndk_roots(name = "ndk-system-roots", ndk = ":ndk", ndk_dir = _NDK, llvm_major = "21", visibility = ["PUBLIC"])

