load("@gate//rules:c.bzl", "c_library", "c_mutants", "c_test")

# The wire invariants I3 to I6b of P330 section 2.1 (T2G3): a gate-owned Modbus RTU decoder and the coil model.
# Gate code under the rules of any product: pure, static memory, tested through the public headers, mutation-tested.
c_library(
    name = "frame",
    srcs = ["frame.c"],
    headers = ["frame.h"],
    visibility = ["PUBLIC"],
)

c_library(
    name = "wire",
    srcs = ["wire.c"],
    headers = ["wire.h", "wire_consts.h"],
    deps = [":frame"],
    exported_deps = ["//sim:world"],
    visibility = ["PUBLIC"],
)

# The test kit of the wire tests: builds frames and feeds them to an engine.
c_library(
    name = "rig",
    srcs = ["tests/rig.c"],
    headers = ["tests/rig.h"],
    exported_deps = [":wire", ":frame", "gate//ctest:ctest"],
)

c_test(name = "frame_test", srcs = ["tests/frame_test.c"], deps = [":frame"])
c_test(name = "wire_test", srcs = ["tests/wire_test.c"], deps = [":rig"])
c_test(name = "flight_test", srcs = ["tests/flight_test.c"], deps = [":rig"])
c_test(name = "watchdog_test", srcs = ["tests/watchdog_test.c"], deps = [":rig"])
# The two recordings of the conformance script as `fr` records, generated by tools/sim/fixture_to_fr.py (the positive control).
c_library(
    name = "fixtures",
    srcs = ["tests/fixtures_data.c"],
    headers = ["tests/fixtures_data.h"],
)

c_test(name = "fixtures_test", srcs = ["tests/fixtures_test.c"], deps = [":fixtures", ":wire", ":frame"])

c_mutants(name = "frame_mutants", module = ":frame", tests = [":frame_test", ":wire_test", ":flight_test", ":watchdog_test", ":fixtures_test"], deps = [":wire", ":rig", ":fixtures"])
c_mutants(name = "wire_mutants", module = ":wire", tests = [":wire_test", ":flight_test", ":watchdog_test", ":fixtures_test"], deps = [":frame", ":rig", ":fixtures"])

# The event and storage invariants I1, I2, I9, I10 and I15 (T2G4): a pure engine over `ev fx fr io vw` records, the product's rules
# as plain configuration, the book and the audit file through callbacks of the world.
c_library(
    name = "audit",
    srcs = ["audit.c"],
    headers = ["audit.h"],
    visibility = ["PUBLIC"],
)

c_library(
    name = "events",
    srcs = ["events.c", "events_names.c"],
    headers = ["events.h"],
    deps = [":audit", ":frame", ":wire"],
    exported_deps = ["//sim:world"],
    visibility = ["PUBLIC"],
)

# The test kit of the event tests: the lockers-like configuration, a fake world and a record builder.
c_library(
    name = "ev_rig",
    srcs = ["tests/ev_rig.c"],
    headers = ["tests/ev_rig.h"],
    exported_deps = [":events", ":frame", "gate//ctest:ctest"],
)

c_test(name = "ev_auth_test", srcs = ["tests/ev_auth_test.c"], deps = [":ev_rig"])
c_test(name = "ev_store_test", srcs = ["tests/ev_store_test.c"], deps = [":ev_rig"])
c_test(name = "ev_live_test", srcs = ["tests/ev_live_test.c"], deps = [":ev_rig"])
c_test(name = "audit_test", srcs = ["tests/audit_test.c"], deps = [":audit"])

# The fixture product of T2G4: a model of a kiosk with the three seeded bugs `double-pulse`, `no-save-before-open`, `stuck-phase`.
c_library(
    name = "model",
    srcs = ["tests/model.c"],
    headers = ["tests/model.h"],
    exported_deps = [":events", ":ev_rig"],
)

c_test(name = "model_test", srcs = ["tests/model_test.c"], deps = [":model"])

c_mutants(name = "audit_mutants", module = ":audit", tests = [":audit_test"], deps = [])
c_mutants(name = "events_mutants", module = ":events", tests = [":ev_auth_test", ":ev_store_test", ":ev_live_test", ":model_test"], deps = [":audit", ":frame", ":wire", ":ev_rig", ":model"])
