load("@gate//rules:c.bzl", "c_library")
load("@gate//rules:ui.bzl", "c_ui_probe", "c_ui_probe_session")

# The frame toy of selftest/ui_frame.sh (U05a) and its model adapter: implements ui/model/model.h.
c_library(
    name = "model",
    srcs = ["app.c", "app_fixture.c", "model.c"],
    headers = ["app.h"],
    deps = ["gate//ui/model:model"],
    exported_deps = ["gate//third_party/lvgl:lvgl"],
    visibility = ["PUBLIC"],
)

# The probe binary of that model.
c_ui_probe(name = "probe", model = ":model")

# U05c: the scripted session's transcript as a Buck2 test in release and san, besides selftest/ui_frame.sh's own comparison.
c_ui_probe_session(name = "session_test", probe = ":probe", session = "session.in", expected = "session.out")
