load("@gate//rules:c.bzl", "c_library")
load("@gate//rules:ui.bzl", "c_ui_probe", "c_ui_probe_session")

# The toy LVGL app.
c_library(
    name = "toy",
    srcs = ["toy.c"],
    headers = ["toy.h"],
    exported_deps = ["gate//third_party/lvgl:lvgl"],
    visibility = ["PUBLIC"],
)

# Its model adapter: implements ui/model/model.h. This build has no pointer entry (pointer_off.c): the probe injects
# its taps at the app's indev.
c_library(
    name = "model",
    srcs = ["model.c", "pointer_off.c", "identity_off.c"],
    deps = [":toy", "gate//ui/model:model"],
    visibility = ["PUBLIC"],
)

# U05c: the same adapter WITH the toy's pointer entry (pointer_on.c): taps go through `uim_pointer`, the app's queue
# above LVGL, and post `touch`.
c_library(
    name = "model_pointer",
    srcs = ["model.c", "pointer_on.c", "identity_off.c"],
    deps = [":toy", "gate//ui/model:model"],
)

# The probe binary of that model.
c_ui_probe(name = "probe", model = ":model")

# U05c: the scripted session's transcript as a Buck2 test in release and san, besides selftest/ui.sh's own comparison.
c_ui_probe_session(name = "session_test", probe = ":probe", session = "session.in", expected = "session.out")

# U05c: the probe of the build with the pointer entry, and the taps session on both builds (selftest/ui.sh checks the
# facts of the two transcripts: `touch` only through the entry, the click's work at the tap's instant, a blocked tap).
c_ui_probe(name = "probe_pointer", model = ":model_pointer")

c_ui_probe_session(name = "pointer_test", probe = ":probe_pointer", session = "pointer.in", expected = "pointer.out")

c_ui_probe_session(name = "pointer_noentry_test", probe = ":probe", session = "pointer.in", expected = "pointer_noentry.out")

# U24 fix-up 1: the adapter with a scene identity that breaks the interface (identity_bad.c): selftest/ui.sh sees
# `err identity model-contract`, `fail identity`, and that neither poisons.
c_library(
    name = "model_identity_bad",
    srcs = ["model.c", "pointer_off.c", "identity_bad.c"],
    deps = [":toy", "gate//ui/model:model"],
)

c_ui_probe(name = "probe_identity_bad", model = ":model_identity_bad")

# Ordinary product code that calls a `uim_*` symbol: flagged by the symbols gate.
c_library(
    name = "misuse",
    srcs = ["misuse.c"],
    deps = [":model", "gate//ui/model:model"],
)

# Ordinary product code that defines a `uim_*` symbol: flagged by the symbols gate as an export it does not declare.
c_library(
    name = "misdef",
    srcs = ["misdef.c"],
    deps = ["gate//ui/model:model"],
)

# U05: the shared core of two deliberately broken model adapters for the explorer (it defines no `uim_` symbol).
c_library(
    name = "fixture",
    srcs = ["fixture.c"],
    headers = ["fixture.h"],
    deps = [":toy"],
)

# A nondeterministic adapter (the trace carries the process id): `rigor ui-explore` gives model-nondeterministic.
c_library(
    name = "model_nondet",
    srcs = ["model_nondet.c"],
    deps = [":fixture", ":toy", "gate//ui/model:model"],
)

c_ui_probe(name = "probe_nondet", model = ":model_nondet")

# A starving adapter (a timer that re-arms itself 1 ms later forever): `rigor ui-explore` gives timer-starvation.
c_library(
    name = "model_starve",
    srcs = ["model_starve.c"],
    deps = [":fixture", ":toy", "gate//ui/model:model"],
)

c_ui_probe(name = "probe_starve", model = ":model_starve")

# A correct adapter with a perpetual 250 ms tick: settle ends, until-change is one event, no finding.
c_library(
    name = "model_tick",
    srcs = ["model_tick.c"],
    deps = [":fixture", ":toy", "gate//ui/model:model"],
)

c_ui_probe(name = "probe_tick", model = ":model_tick")

# U05a: ordinary product code that calls an lvprobe symbol, and code that defines an `lvp_` name: both flagged
# (`ui-lvprobe-symbol`), whatever the policy allows.
c_library(
    name = "lvpuse",
    srcs = ["lvpuse.c"],
)

c_library(
    name = "lvpdef",
    srcs = ["lvpdef.c"],
)
