load("@gate//rules:c.bzl", "c_binary", "c_library", "c_test")

c_library(
    name = "lib",
    srcs = ["hello.c"],
    headers = ["hello.h"],
    visibility = ["PUBLIC"],
)

c_binary(name = "hello", srcs = ["main.c"], deps = [":lib"])

c_test(name = "hello_test", srcs = ["hello_test.c"], deps = [":lib"])
